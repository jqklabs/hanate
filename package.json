{
  "name": "hanate",
  "private": true,
  "type": "module",
  "description": "십이화 : 무한의 판",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-static.mjs",
    "preview": "vite preview",
    "test": "vite-node test/test-game.mjs",
    "golden": "node test/golden/run.mjs",
    "golden:update": "node test/golden/run.mjs --update",
    "golden:check": "node test/golden/run.mjs --twice",
    "bot:train": "vite-node bot/train.ts",
    "bot:train:until": "vite-node bot/train.ts --until-month 10 --workers 4",
    "bot:eval": "vite-node bot/train.ts --eval",
    "og:gen": "node scripts/og-landing-html.mjs",
    "firebase:config": "node scripts/generate-firebase-config.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
