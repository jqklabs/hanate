rules_version = '2';
// Firebase Console → Firestore → Rules 에 붙여넣기
// Anonymous Auth 활성화 필수 (firebase-telemetry.mjs 가 signInAnonymously 사용)

service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      function allowedEvent() {
        return request.resource.data.event in [
          'session_start', 'session_end', 'run_end',
          'hand_play', 'cards_discard', 'shop_buy', 'shop_reroll', 'settle'
        ];
      }
      function validPayload() {
        return request.resource.data.keys().hasAll(['uid', 'event', 'params'])
          && request.resource.data.uid is string
          && request.resource.data.uid.size() <= 64
          && request.resource.data.event is string
          && request.resource.data.params is map
          && request.resource.data.params.size() <= 25
          && allowedEvent();
      }
      allow create: if request.auth != null && validPayload();
      allow read, update, delete: if false;
    }

    match /users/{userId} {
      function validUser() {
        // created_at(serverTimestamp)는 Rules 평가 시 absent — hasAll에 넣으면 항상 거부
        return request.resource.data.keys().hasAll(['is_invite'])
          && request.resource.data.is_invite in [0, 1]
          && userId.size() <= 64
          && (
            !request.resource.data.keys().hasAny(['og_image'])
            || (request.resource.data.og_image is string
                && request.resource.data.og_image.size() > 0
                && request.resource.data.og_image.size() <= 32)
          );
      }
      allow create: if request.auth != null && validUser() && !exists(/databases/$(database)/documents/users/$(userId));
      allow read, update, delete: if false;
    }
  }
}
